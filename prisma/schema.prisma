generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiscordMember {
  guildId       String
  discordUserId String
  username      String
  displayName   String
  avatarUrl     String?
  roleIds       String[]  @default([])
  joinedAt      DateTime?
  isBot         Boolean
  lastSyncedAt  DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@id([guildId, discordUserId])
  @@index([discordUserId])
  @@index([guildId, displayName, username])
}

model DiscordRole {
  guildId       String
  discordRoleId String
  name          String
  position      Int
  color         Int?
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@id([guildId, discordRoleId])
  @@index([discordRoleId])
  @@index([guildId, position])
  @@index([guildId, name])
}

model DiscordSyncState {
  guildId             String   @id
  lastSuccessfulSync  DateTime?
  lastSyncStartedAt   DateTime?
  lastSyncCompletedAt DateTime?
  status              String
  memberCount         Int      @default(0)
  roleCount           Int      @default(0)
  lastError           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([status])
}

model AdminTimezone {
  guildId       String
  discordUserId String
  timezone      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@id([guildId, discordUserId])
  @@index([discordUserId])
}

model Event {
  id           String   @id
  guildId      String
  channelId    String
  messageId    String?
  title        String
  description  String   @default("")
  notes        String?
  hostId       String
  creatorId    String
  timezone     String
  startAtIso   String
  startAtUnix  Int
  createdAtIso String
  rsvps        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([guildId, startAtUnix])
  @@index([guildId, messageId])
}

model Raffle {
  id             String   @id
  guildId        String
  channelId      String
  messageId      String?
  name           String
  prize          String
  endsAt         BigInt
  tagRole        String?
  invocationText String?
  ritualType     String?
  winnerId       String?
  ended          Boolean  @default(false)
  entries        String[] @default([])
  boundUsers     String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([guildId, endsAt, ended])
  @@index([guildId, messageId])
}

model Bounty {
  id        String   @id
  guildId   String
  channelId String
  messageId String?
  tagRoleId String
  dinos     String[] @default([])
  stats     String[] @default([])
  bonus     String?
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@index([guildId, active])
  @@index([guildId, messageId])
}

model Riddle {
  id        String   @id
  guildId   String
  channelId String
  messageId String?
  question  String
  answer    String
  hint      String?
  reward    Int
  active    Boolean  @default(true)
  winnerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([guildId, active])
  @@index([guildId, messageId])
}

model RiddleGuess {
  id        String   @id
  riddleId  String
  userId    String
  answer    String
  correct   Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([riddleId, createdAt])
  @@index([riddleId, userId])
}

model SigilAccount {
  guildId       String
  discordUserId String
  balance       Int      @default(0)
  lastDaily     BigInt?
  transactions  Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@id([guildId, discordUserId])
  @@index([guildId, balance])
}
model ArcaneCharacter {
  id                String   @id
  guildId           String
  userId            String
  name              String
  classId           String
  level             Int      @default(1)
  xp                Int      @default(0)
  hp                Int
  mana              Int
  baseStats         Json
  equippedSpellIds  String[] @default([])
  ownedItemIds      String[] @default([])
  armorId           String
  focusId           String
  relicIds          String[] @default([])
  cosmetics         String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([guildId, userId])
  @@index([guildId, level, xp])
}

model ArcaneQuestProgress {
  id        String   @id
  guildId   String
  userId    String
  chapter   String   @default("hollow_crown_1")
  step      Int      @default(0)
  state     Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, userId])
  @@index([guildId, chapter])
}

model ArcaneBattle {
  id           String   @id
  guildId      String
  challengerId String
  opponentId   String
  turnUserId   String
  status       String   @default("active")
  round        Int      @default(1)
  state        Json
  messageId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([guildId, status])
  @@index([guildId, challengerId, status])
  @@index([guildId, opponentId, status])
}

model ArcaneFamiliarCollection {
  id        String   @id
  guildId   String
  userId    String
  ownedIds  String[] @default(["archive_wisp"])
  equippedId String @default("archive_wisp")
  bond      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, userId])
  @@index([guildId, bond])
}
